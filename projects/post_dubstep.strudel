$: setcpm(120/4)

let melody = n("[[1 -] [4@2 5] [3 -] [6b 8*2]]/2")
  .scale("E2:minor:pentatonic")
  .s("sawtooth")
  .adsr("0.55:0.1:0.1:0.15")
  .lpf(350)
  .room(2)
  .gain(0.8)
  .ftype("<ladder 12db 16db>")
  .room("<1 2 3 4>").lpf("<400 600 700 500>")

let melody2 = n("[[1*4] [4*4] [3*4] [5 7 [8 6]]]/2")
  .scale("E3:minor:pentatonic")
  .s("sawtooth")
  .adsr("0.05:0.1:0.1:0.15")
  .lpf(350)
  .room(2)
  .gain(1.5)

let bass = n("[1*2 4*3 3*2 6b*3]/2")
  .scale("E1:minor:pentatonic")
  .s("sine")
  .lpf(200)
  .adsr("0.1:0.2:0.2:0.1")
  .gain(1.5)

let bass2 = n("[1 0 2 -1]/8")
  .scale("E1:minor:pentatonic")
  .s("sine")
  .lpf(200)
  .adsr("0.1:0.2:0.2:0.1")
  .gain(2.5)

let organ = n("[[[1, 3, 5, 9] -] [4 4 5*3 4] [3, 5, 7, 9 -] [8 [5, 4, 2]]]/2")
  .scale("E2:minor:pentatonic")
  .s("gm_church_organ")
  .gain(0.35)
  .room(3)
  .lpf(900)
  .penv(12)

let doodoo = n("[[[5]] [4 4b] [3] [8 9b]]/2")
  .scale("E3:minor:pentatonic")
  .s("gm_voice_oohs")
  .gain(0.55)
  .room(2)
  .lpf(2300)
  .hpf(1000)
  .delay(1.1)

let pad_bells = n("[1 4 3 6b]/2")
  .scale(`
    E5:minor:pentatonic,
    E4:minor:pentatonic,
    E3:minor:pentatonic
  `)
  .s("gm_pad_bowed")
  .adsr("0.85:0.1:0.2:0.55")
  .lpf(1300)
  .room(2)
  .gain(0.15)
  .trem(0.3, 0.4)

let drums = sound(`
    [<bd bd*2> - - <bd*2 ->],
    [- hh - <hh*2 [hh*2, oh]>],
    [- rim - rim]
  `)
  .bank("RolandTR707")
  .lpf(1200)
  .room(1)
  .delay(0.25)
  .gain(0.7)

let drums2 = sound(`
    [<bd bd*2> - bd <bd*2 bd>],
    [- hh [hh hh] <hh*2 [oh hh]>],
    [- rim rim -]
  `)
  .bank("RolandTR707")
  .lpf(1200)
  .room(1)
  .delay(0.25)
  .gain(0.6)

let shaker = sound(`
    [hh*2 hh*2 hh*2 hh*2]
  `)
  .bank("RhythmAce")
  .lpf(2000)
  .room(2)
  .delay(0.4)
  .gain(0.5)

let shaker2 = sound(`
    [hh hh hh hh]
  `)
  .bank("RhythmAce")
  .lpf(1500)
  .room(2)
  .delay(0.4)
  .gain(0.3)

let noise = s("white")
  .lpf(600)  
  .adsr("2:0.3:0.8:1.5")
  .room(4)
  .gain(0.2)
  .pan(sine.range(0,1))

$: arrange(
  [4, stack(noise, organ)],                                        
  [2, stack(noise, doodoo, organ, bass, shaker2)],                          
  [4, stack(noise, doodoo, pad_bells, bass, organ, shaker2)],           
  [2, stack(noise, doodoo, pad_bells, bass, organ, shaker2, drums)],                  
  [4, stack(noise, doodoo, pad_bells, bass, organ, shaker, drums, melody)], 
  [2, stack(noise, doodoo, pad_bells, organ)], 
  [16, stack(noise, doodoo, pad_bells, bass, organ, shaker, drums2, melody2)],
  [8, stack(bass2, melody2)],
  [8, stack(noise, bass2, melody2, shaker, drums2)],
  [2, stack(noise, bass2, melody2, shaker, drums)],
  [10, sound("-")]
)